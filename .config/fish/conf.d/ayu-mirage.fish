# Ayu Mirage — matches ~/.config/starship.toml palettes.ayu_mirage
# and the syntax highlighting you'd see in the zsh + Ghostty setup.

set -g fish_color_normal         BFBDB6
set -g fish_color_command        59C2FF
set -g fish_color_keyword        FF8F40
set -g fish_color_quote          AAD94C
set -g fish_color_redirection    D2A6FF
set -g fish_color_end            FF8F40
set -g fish_color_error          F07178
set -g fish_color_param          BFBDB6
set -g fish_color_valid_path     95E6CB --underline
set -g fish_color_option         FFB454
set -g fish_color_comment        5C6773
set -g fish_color_selection      --background=1B3A5B
set -g fish_color_operator       95E6CB
set -g fish_color_escape         95E6CB
set -g fish_color_autosuggestion 5C6773
set -g fish_color_cwd            FFB454
set -g fish_color_cwd_root       F07178
set -g fish_color_user           FF8F40
set -g fish_color_host           59C2FF
set -g fish_color_host_remote    AAD94C
set -g fish_color_status         F07178
set -g fish_color_cancel         F07178 --reverse
set -g fish_color_search_match   --background=1F2430
set -g fish_color_history_current --bold
set -g fish_color_match          59C2FF --underline

set -g fish_pager_color_progress              5C6773
